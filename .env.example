# FinOps Copilot — environment configuration template
# Copy to .env and fill in your values.  NEVER commit .env to version control.

# ── IBM Cloud Logs ──────────────────────────────────────────────────────────
# IBM Cloud API key used to obtain IAM tokens for the ICL data-usage API.
IBM_CLOUD_API_KEY=your-ibm-cloud-api-key

# IBM Cloud Logs instance GUID (find it in the IBM Cloud console → Resource list).
ICL_INSTANCE_ID=your-icl-instance-guid

# ICL region (e.g. us-south, eu-de, au-syd)
ICL_REGION=us-south

# ── GitHub integration ───────────────────────────────────────────────────────
# GitHub personal access token or App installation token with repo:read scope.
FINOPS_GITHUB_TOKEN=your-github-token

# GitHub organisation or user that owns the repos you want to analyse.
FINOPS_GITHUB_ORG=your-github-org

# ── Application ──────────────────────────────────────────────────────────────
# Set to "production" to enforce API key auth on all endpoints.
FINOPS_ENVIRONMENT=development

# Comma-separated API keys (required when FINOPS_ENVIRONMENT=production).
FINOPS_API_KEYS=

# ── LLM provider (default: offline — no LLM required) ────────────────────────
# Options: offline | openai | azure_openai | watsonx
FINOPS_LLM_PROVIDER=offline

# OpenAI
# FINOPS_OPENAI_API_KEY=sk-...
# FINOPS_OPENAI_MODEL=gpt-4.1

# Azure OpenAI
# FINOPS_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# FINOPS_AZURE_OPENAI_API_KEY=...
# FINOPS_AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# IBM watsonx.ai
# FINOPS_WATSONX_API_KEY=your-watsonx-api-key
# FINOPS_WATSONX_PROJECT_ID=your-project-id
# FINOPS_WATSONX_MODEL_ID=ibm/granite-3-8b-instruct
